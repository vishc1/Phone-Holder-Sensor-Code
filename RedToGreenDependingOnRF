#include <Wire.h>
#include <Adafruit_ADS1X15.h>

Adafruit_ADS1115 ads;

// RGB PWM pins (Arduino Uno PWM pins include 3,5,6,9,10,11) [web:55]
const int PIN_R = 9;
const int PIN_G = 10;
const int PIN_B = 11;

// Voltage thresholds
const float V_GREEN = 1.50;  // <= this = green
const float V_RED   = 1.65;  // >= this = red

// Clamp helper
float clamp01(float x) {
  if (x < 0) return 0;
  if (x > 1) return 1;
  return x;
}

void setup() {
  Serial.begin(9600);

  pinMode(PIN_R, OUTPUT);
  pinMode(PIN_G, OUTPUT);
  pinMode(PIN_B, OUTPUT);

  if (!ads.begin()) {
    Serial.println("ERROR: ADS1115 NOT FOUND");
    while (1);
  }

  ads.setGain(GAIN_TWOTHIRDS); // ±6.144 V range

  Serial.println("Baseline RF Measurement");
  Serial.println("Ensure NO phone is near the antenna");
  Serial.println("Collecting data...");
  Serial.println("Time(ms), Voltage(V), ColorMix(0=Green..1=Red)");
}

void loop() {
  static unsigned long startTime = millis();

  int16_t raw = ads.readADC_SingleEnded(0);

  // Your original conversion (kept the same)
  float voltage = raw * 0.1875 / 1000.0;  // volts

  // Map voltage to a 0..1 mix amount
  // 0 => green, 1 => red
  float t = (voltage - V_GREEN) / (V_RED - V_GREEN);
  t = clamp01(t);

  // PWM values (0..255)
  // Green decreases as t increases; Red increases as t increases
  int r = (int)(255 * t);
  int g = (int)(255 * (1.0 - t));
  int b = 0;

  analogWrite(PIN_R, r);
  analogWrite(PIN_G, g);
  analogWrite(PIN_B, b);

  Serial.print(millis() - startTime);
  Serial.print(", ");
  Serial.print(voltage, 3);
  Serial.print(", ");
  Serial.println(t, 3);

  delay(100); // 10 samples per second
}
