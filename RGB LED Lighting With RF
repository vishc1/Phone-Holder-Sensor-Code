#include <Wire.h>
#include <Adafruit_ADS1X15.h>

Adafruit_ADS1115 ads;

// RGB pins (PWM capable)
const int RED_PIN   = 8;
const int GREEN_PIN = 9;
const int BLUE_PIN  = 10;

// Baseline voltage
float baseline = 0.0;

// ---------- TUNING (JUST FOR TESTING) ----------
float MAX_DELTA = 0.30;   // max ΔV expected (adjust if needed)
// ----------------------------------------------

void setup() {
  Serial.begin(9600);

  pinMode(RED_PIN, OUTPUT);
  pinMode(GREEN_PIN, OUTPUT);
  pinMode(BLUE_PIN, OUTPUT);

  if (!ads.begin()) {
    Serial.println("ADS1115 NOT FOUND");
    while (1);
  }

  ads.setGain(GAIN_TWOTHIRDS);

  // ---- Baseline calibration ----
  Serial.println("Calibrating baseline (NO PHONE)");
  float sum = 0;
  for (int i = 0; i < 50; i++) {
    float v = ads.readADC_SingleEnded(0) * 0.1875 / 1000.0;
    sum += v;
    delay(20);
  }
  baseline = sum / 50.0;

  Serial.print("Baseline = ");
  Serial.println(baseline, 3);
}

void loop() {
  float voltage = ads.readADC_SingleEnded(0) * 0.1875 / 1000.0;
  float delta = voltage - baseline;

  // Clamp ΔV
  if (delta < 0) delta = 0;
  if (delta > MAX_DELTA) delta = MAX_DELTA;

  // Map ΔV → 0–255
  int level = map(delta * 1000, 0, MAX_DELTA * 1000, 0, 255);

  // ----- COLOR GRADIENT -----
  int r, g, b;

  if (level < 85) {
    // Blue → Purple
    r = level * 3;
    g = 0;
    b = 255;
  }
  else if (level < 170) {
    // Purple → Green
    r = 255 - (level - 85) * 3;
    g = (level - 85) * 3;
    b = 255 - (level - 85) * 3;
  }
  else {
    // Green → Yellow → Red
    r = (level - 170) * 3;
    g = 255 - (level - 170) * 3;
    b = 0;
  }

  analogWrite(RED_PIN, r);
  analogWrite(GREEN_PIN, g);
  analogWrite(BLUE_PIN, b);

  // Debug output
  Serial.print("V=");
  Serial.print(voltage, 3);
  Serial.print("  ΔV=");
  Serial.print(delta, 3);
  Serial.print("  ColorLevel=");
  Serial.println(level);

  delay(80);
}

